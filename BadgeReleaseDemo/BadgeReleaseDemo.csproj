<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BadgeReleaseDemo</RootNamespace>
    <AssemblyName>BadgeReleaseDemo</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OverwriteReadOnlyFiles>true</OverwriteReadOnlyFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.74.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.7.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="badgeapisettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\SampleDocument.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="SetSettingsFilePermissions" AfterTargets="CopyFilesToOutputDirectory">
    <Exec
      Condition="'$(OS)' == 'Windows_NT'"
      Command="attrib -R &quot;$(TargetDir)appsettings.json&quot; &amp;&amp; attrib +R &quot;$(TargetDir)badgeapisettings.json&quot;" />
    <Exec
      Condition="'$(OS)' != 'Windows_NT'"
      Command="chmod u+w &quot;$(TargetDir)appsettings.json&quot; &amp;&amp; chmod a-w &quot;$(TargetDir)badgeapisettings.json&quot;" />
  </Target>

</Project>
